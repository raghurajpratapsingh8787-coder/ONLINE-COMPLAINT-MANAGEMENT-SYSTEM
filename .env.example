# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# NODE_ENV: development or production
NODE_ENV="development"

# PORT: Server HTTP/Socket.IO port (must be 3000 in AI Studio preview)
PORT="3000"

# MONGODB_URI: Connection string for MongoDB Atlas or local MongoDB.
# When provided, Mongoose connects directly to MongoDB with full schemas & indexes.
# When omitted in local development, a local file-backed Mongoose-compatible store is used.
MONGODB_URI=""

# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET: Strong 64-byte hex secrets for signing JWTs.
# When omitted in development, ephemeral in-memory crypto secrets are generated at runtime.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ADMIN_INITIAL_PASSWORD: Optional initial password for the Super Admin account
# (Raghuraj Pratap Singh - raghurajpratapsingh8787@gmail.com).
# If omitted, use the one-time First-Run Admin Setup form on initial launch.
ADMIN_INITIAL_PASSWORD=""

# CORS_ORIGINS: Comma-separated allowlist of origins permitted to access the API.
CORS_ORIGINS="http://localhost:3000"

# UPLOAD_MAX_MB: Maximum allowed evidence file size in megabytes (default 5).
UPLOAD_MAX_MB="5"

# SMTP Email Configuration (Nodemailer — optional; logs preview notices if omitted)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ResolveDesk <no-reply@resolvedesk.edu>"

# SLA_CHECK_INTERVAL_MS: Interval in ms for automatic overdue escalation checks (default 60000).
SLA_CHECK_INTERVAL_MS="60000"
